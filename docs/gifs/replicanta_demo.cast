    \u001b[38;2;1;120;212m\u2502\u001b[38;2;224;224;224m                                                                                             \u001b[48;2;0;0;0m  \u001b[39m\u001b[48;2;30;30;30m \u001b[49m\u001b[48;2;30;30;30m\u001b[12;1H                       \u001b[38;2;1;120;212m\u2502\u001b[39m \u001b[38;2;152;224;36m\u256d\u2500 default \u00b7 17:09 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[38;2;224;224;224m\u001b[48;2;0;0;0m  \u001b[39m\u001b[48;2;30;30;30m \u001b[49m\u001b[48;2;30;30;30m\u001b[13;1H                       \u001b[38;2;1;120;212m\u2502\u001b[39m \u001b[38;2;152;224;36m\u2502\u001b[38;2;224;224;224m Hello Alex, I'm here now and feel a bit lonely without someone to talk to too. It's okay \u001b[38;2;152;224;36m\u2502\u001b[38;2;224;224;224m\u001b[48;2;0;0;0m  \u001b[39m\u001b[48;2;30;30;30m \u001b[49m\u001b[48;2;30;30;30m\u001b[14;1H                       \u001b[38;2;1;120;212m\u2502\u001b[39m \u001b[38;2;152;224;36m\u2502\u001b[38;2;224;224;224m to be alone sometimes; we're all different.                                              \u001b[38;2;152;224;36m\u2502\u001b[38;2;224;224;224m\u001b[48;2;0;0;0m  \u001b[39m\u001b[48;2;30;30;30m \u001b[49m\u001b[48;2;30;30;30m\u001b[15;1H                       \u001b[38;2;1;120;212m\u2502\u001b[39m \u001b[38;2;152;224;36m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\